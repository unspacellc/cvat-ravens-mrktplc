{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset_version_published_v1.schema.json",
  "title": "labeling.dataset_version.published.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "tenant_id",
    "dataset_version_id",
    "manifest",
    "batch_id",
    "occurred_at",
    "correlation_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "labeling.dataset_version.published.v1"
    },
    "schema_version": {
      "const": 1
    },
    "tenant_id": {
      "type": "string"
    },
    "dataset_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "version",
        "sha256"
      ],
      "properties": {
        "uri": {
          "type": "string"
        },
        "version": {
          "const": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string"
    }
  }
}

# Copy to deploy/.env (gitignored via *.env). No real secrets here.
CVAT_VERSION=v2.80.0
CVAT_HOST=localhost
# Docker Desktop host address, allowlisted in Smokescreen so CVAT can POST webhooks to the host-run integration API.
# Resolve with: docker exec cvat_server getent hosts host.docker.internal
WEBHOOK_TARGET_ALLOW_ADDRESS=192.168.65.254
CVAT_PROJECT=cvat-int
LABELING_DATABASE_URL=postgresql+psycopg://labeling:labeling-local-only@localhost:5433/labeling

# Dev only: include the mock OIDC IdP + OIDC env in the stack (needed by tests/capability/test_oidc_login.py)
WITH_IDP=1

# --- Cognito (production identity) ---
# Portal API verifies Cognito access tokens (JWKS URL derived from region + pool; no discovery call at boot).
# LABELING_COGNITO_REGION=us-east-1
# LABELING_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# LABELING_JWT_CLIENT_IDS=<marketplace app client id>[,<cvat editor app client id>]
# Web host sign-in posts credentials to the marketplace API (POST /auth/login). The Cognito app client behind it must be in
# LABELING_JWT_CLIENT_IDS above, or the portal API rejects its tokens.
# MARKETPLACE_API_URL=https://api.unspace.cassyork.com
# Server-side secret for the marketplace /sessions token store (required in production; dev falls back to in-process memory).
# MARKETPLACE_API_KEY=<internal service key>
# Where "Back to portal" in the header goes (hidden when unset).
# MARKETPLACE_PORTAL_URL=https://<marketplace web host>
# Dev: clips the creation wizard offers live in <LABELING_CLIP_ROOT>/<tenant id>/*.mp4 (default fixtures/generated); seed with scripts/seed_poc.py.
# CVAT editor login (second prompt) uses a Cognito app client with a secret; point CVAT's OIDC at the same pool:
# LABELING_OIDC_ISSUER=https://cognito-idp.<region>.amazonaws.com/<pool id>
# LABELING_OIDC_CLIENT_ID=<cvat editor app client id>
# LABELING_OIDC_CLIENT_SECRET=<secret>

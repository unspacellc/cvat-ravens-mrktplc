diff --git a/cvat/apps/labeling_guard/views.py b/cvat/apps/labeling_guard/views.py
new file mode 100644
index 000000000..630ea1e7b
--- /dev/null
+++ b/cvat/apps/labeling_guard/views.py
@@ -0,0 +1,92 @@
+# Copyright (C) CVAT.ai Corporation
+#
+# SPDX-License-Identifier: MIT
+
+from rest_framework import permissions, status
+from rest_framework.response import Response
+from rest_framework.views import APIView
+
+from . import guard
+
+
+class FreezeView(APIView):
+    """PUT {send_off_id} freezes; DELETE unfreezes (abort before publication). Superusers only."""
+
+    permission_classes = [permissions.IsAdminUser]
+
+    def get(self, request, task_id: int):
+        return Response({"frozen": guard.is_frozen(task_id)})
+
+    def put(self, request, task_id: int):
+        obj = guard.freeze(task_id, str(request.data.get("send_off_id", "")))
+        return Response({"frozen": True, "send_off_id": obj.send_off_id}, status=status.HTTP_200_OK)
+
+    def delete(self, request, task_id: int):
+        guard.unfreeze(task_id)
+        return Response(status=status.HTTP_204_NO_CONTENT)
+
+
+class OrganizationMemberView(APIView):
+    """Superuser-only provisioning (CVAT has no add-member endpoint; invitations need an email backend).
+
+    PUT {username, email?, role, uid?}: ensure the user exists (unusable password; sign-in is via OIDC) and is an
+    active member with `role`. With `uid` (the IdP `sub`) the user is linked to that identity for the configured
+    provider, so the person's own OIDC login resolves to exactly this user (no email matching).
+    DELETE {username, deactivate?}: revoke membership (and optionally the account). Idempotent.
+    """
+
+    permission_classes = [permissions.IsAdminUser]
+    ROLES = {"worker", "supervisor", "maintainer", "owner"}
+
+    def put(self, request, slug: str):
+        from django.contrib.auth import get_user_model
+        from django.utils import timezone
+
+        from cvat.apps.organizations.models import Membership, Organization
+
+        username, role = request.data.get("username"), request.data.get("role")
+        if not username or role not in self.ROLES:
+            return Response({"detail": "username and a valid role are required"}, status=status.HTTP_400_BAD_REQUEST)
+        try:
+            org = Organization.objects.get(slug=slug)
+        except Organization.DoesNotExist:
+            return Response(status=status.HTTP_404_NOT_FOUND)
+        User = get_user_model()
+        user, created = User.objects.get_or_create(username=username, defaults={"email": request.data.get("email", "")})
+        if created:
+            user.set_unusable_password()
+            user.save(update_fields=["password"])
+        uid = request.data.get("uid")
+        if uid:
+            from django.conf import settings
+            from allauth.socialaccount.models import SocialAccount
+
+            provider = settings.LABELING_OIDC_PROVIDER_ID
+            link, _ = SocialAccount.objects.get_or_create(provider=provider, uid=str(uid), defaults={"user": user})
+            if link.user_id != user.id:
+                return Response({"detail": "identity already linked to another user"}, status=status.HTTP_409_CONFLICT)
+            if not user.is_active:
+                user.is_active = True
+                user.save(update_fields=["is_active"])
+        member, _ = Membership.objects.update_or_create(
+            user=user, organization=org, defaults={"is_active": True, "role": role, "joined_date": timezone.now()}
+        )
+        return Response({"user_id": user.id, "membership_id": member.id, "role": member.role, "created_user": created})
+
+    def delete(self, request, slug: str):
+        from cvat.apps.organizations.models import Membership
+
+        username = request.data.get("username")
+        deleted, _ = Membership.objects.filter(organization__slug=slug, user__username=username).delete()
+        if request.data.get("deactivate"):
+            from django.contrib.auth import get_user_model
+            from django.contrib.sessions.models import Session
+
+            user = get_user_model().objects.filter(username=username, is_superuser=False).first()
+            if user:
+                user.is_active = False
+                user.save(update_fields=["is_active"])
+                for sess in Session.objects.all():  # end live sessions of the deactivated user
+                    if str(sess.get_decoded().get("_auth_user_id")) == str(user.id):
+                        sess.delete()
+        return Response(status=status.HTTP_204_NO_CONTENT if deleted else status.HTTP_404_NOT_FOUND)

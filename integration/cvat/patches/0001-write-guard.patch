+# Copyright (C) CVAT.ai Corporation
+#
+# SPDX-License-Identifier: MIT
+
+from django.conf import settings
+from django.utils.http import url_has_allowed_host_and_scheme
+
+from allauth.core import context
+from allauth.socialaccount.adapter import DefaultSocialAccountAdapter
+
+from cvat.apps.iam.adapters import DefaultAccountAdapterEx
+
+
+class StrictReturnAccountAdapter(DefaultAccountAdapterEx):
+    """Return URLs may only target this host or explicit LABELING_ALLOWED_RETURN_HOSTS.
+
+    Upstream allauth also trusts every ALLOWED_HOSTS entry, and the stock compose sets ALLOWED_HOSTS='*',
+    which would make any `next=https://attacker` an open redirect after login.
+    """
+
+    def is_safe_url(self, url: str) -> bool:
+        allowed = {context.request.get_host(), *getattr(settings, "LABELING_ALLOWED_RETURN_HOSTS", ())}
+        return url_has_allowed_host_and_scheme(url, allowed_hosts=allowed)
+
+
+class ProvisionedOnlySocialAdapter(DefaultSocialAccountAdapter):
+    """OIDC login may only sign in identities the portal already linked (SocialAccount provider+uid, created by the
+    member endpoint). Unknown identities cannot self-register and nothing is linked by email."""
+
+    def is_open_for_signup(self, request, sociallogin):
+        return bool(getattr(settings, "LABELING_OIDC_AUTO_SIGNUP", False))

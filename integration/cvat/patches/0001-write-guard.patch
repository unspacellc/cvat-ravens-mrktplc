index 000000000..0c7050a9c
--- /dev/null
+++ b/cvat/apps/labeling_guard/guard.py
@@ -0,0 +1,76 @@
+# Copyright (C) CVAT.ai Corporation
+#
+# SPDX-License-Identifier: MIT
+
+"""Server-side write freeze.
+
+Race-safety: writers take a *shared* transaction advisory lock on the task id and then check for a
+TaskFreeze row inside the same transaction; the freezer takes the *exclusive* lock, so it waits for
+in-flight writers to commit and every later writer sees the freeze row.
+"""
+
+import functools
+
+from django.db import connection, transaction
+
+from cvat.apps.engine import models
+
+from .models import TaskFreeze
+
+_LOCK_CLASS = 0x4C42  # "LB"; namespaces our advisory locks
+
+
+class TaskFrozenError(Exception):
+    def __init__(self, task_id: int):
+        super().__init__(f"task {task_id} is frozen by a batch send-off")
+        self.task_id = task_id
+
+
+def _advisory(fn: str, task_id: int) -> None:
+    with connection.cursor() as cur:
+        cur.execute(f"SELECT {fn}(%s, %s)", [_LOCK_CLASS, task_id])
+
+
+def assert_writable(task_id: int) -> None:
+    assert connection.in_atomic_block, "assert_writable must run inside the writer's transaction"
+    _advisory("pg_advisory_xact_lock_shared", task_id)
+    if TaskFreeze.objects.filter(pk=task_id).exists():
+        raise TaskFrozenError(task_id)
+
+
+def is_frozen(task_id: int) -> bool:
+    return TaskFreeze.objects.filter(pk=task_id).exists()
+
+
+def freeze(task_id: int, send_off_id: str) -> TaskFreeze:
+    with transaction.atomic():
+        _advisory("pg_advisory_xact_lock", task_id)  # waits for in-flight writers
+        obj, _ = TaskFreeze.objects.get_or_create(task_id=task_id, defaults={"send_off_id": send_off_id})
+        return obj
+
+
+def unfreeze(task_id: int) -> None:
+    with transaction.atomic():
+        _advisory("pg_advisory_xact_lock", task_id)
+        TaskFreeze.objects.filter(pk=task_id).delete()
+
+
+def task_id_of_job(job_id: int, db_job: "models.Job | None" = None) -> int:
+    if db_job is not None:
+        return db_job.segment.task_id
+    return models.Job.objects.values_list("segment__task_id", flat=True).get(pk=job_id)
+
+
+def guard_task_writes(task_id_getter):
+    """Decorator for @transaction.atomic annotation writers. Apply *outside* @transaction.atomic's
+    inner function but inside the atomic block, i.e. place it below @transaction.atomic."""
+
+    def deco(fn):
+        @functools.wraps(fn)
+        def wrapper(*args, **kwargs):
+            assert_writable(task_id_getter(*args, **kwargs))
+            return fn(*args, **kwargs)
+
+        return wrapper
+
+    return deco
diff --git a/cvat/apps/labeling_guard/middleware.py b/cvat/apps/labeling_guard/middleware.py
new file mode 100644
index 000000000..8a3ea2bc6
--- /dev/null
+++ b/cvat/apps/labeling_guard/middleware.py
@@ -0,0 +1,52 @@
+# Copyright (C) CVAT.ai Corporation
+#
+# SPDX-License-Identifier: MIT
+
+"""Blocks mutating REST requests against frozen tasks, for every credential type (sessions included).
+
+Annotation writes are additionally guarded atomically inside dataset_manager; this layer covers
+workflow/metadata/data/task mutations (job stage/state/assignee, task edit/delete, data upload, ...).
+Hiding UI is not the control: this runs server-side before any view.
+"""
+
+import re
+
+from django.http import JsonResponse
+
+from cvat.apps.engine import models
+
+from .guard import TaskFrozenError, is_frozen
+
+_SAFE = {"GET", "HEAD", "OPTIONS"}
+_TASK_RE = re.compile(r"^/api/tasks/(\d+)(?:/|$)")
+_JOB_RE = re.compile(r"^/api/jobs/(\d+)(?:/|$)")
+_LABEL_RE = re.compile(r"^/api/labels/(\d+)(?:/|$)")
+# Exports are POSTs that only read; send-off must export from frozen tasks.
+_READ_POST_RE = re.compile(r"^/api/(?:tasks|jobs)/\d+/dataset/export/?$")
+
+
+class FrozenTaskMiddleware:
+    def __init__(self, get_response):
+        self.get_response = get_response
+
+    @staticmethod
+    def _task_id(path: str) -> int | None:
+        if m := _TASK_RE.match(path):
+            return int(m[1])
+        if m := _JOB_RE.match(path):
+            return models.Job.objects.values_list("segment__task_id", flat=True).filter(pk=int(m[1])).first()
+        if m := _LABEL_RE.match(path):
+            return models.Label.objects.values_list("task_id", flat=True).filter(pk=int(m[1])).first()
+        return None
+
+    def __call__(self, request):
+        if request.method not in _SAFE and not _READ_POST_RE.match(request.path) and (task_id := self._task_id(request.path)) is not None:
+            if is_frozen(task_id):
+                return JsonResponse({"detail": f"task {task_id} is frozen by a batch send-off", "code": "task_frozen"}, status=423)
+        return self.get_response(request)
+
+    def process_exception(self, request, exception):
+        # Race/worker-path rejection from guard.assert_writable surfaces as a clean 423, never a 500.
+        if isinstance(exception, TaskFrozenError):
+            return JsonResponse({"detail": str(exception), "code": "task_frozen"}, status=423)
+        return None
